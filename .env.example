# BloodBond local config — copy to .env for local runs (never commit .env).
# The AI message writer is the Java backend service (backend/): POST /api/message.
# Set EXPO_PUBLIC_API_URL to the deployed backend origin for native builds
# or local dev (e.g. EXPO_PUBLIC_API_URL=http://localhost:8080). When empty,
# the app uses its honest on-device demo writer. No Gemini key ever belongs
# in this file — GEMINI_API_KEY is set server-side only, in the backend.
EXPO_PUBLIC_API_URL=
GEMINI_API_KEY=<redacted>
